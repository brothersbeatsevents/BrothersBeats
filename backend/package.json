{
  "name": "brothers-beats-backend",
  "version": "1.0.0",
  "description": "Brothers Beats Events - Ticketing Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node esbuild.config.js",
    "build:tsc": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "USE_DYNAMODB=true tsx src/seed/seed-dynamodb.ts",
    "test": "tsx --test src/tests/**/*.test.ts",
    "deploy:dev": "npm run build && sam deploy --config-env dev --profile brothersbeatsdev --no-confirm-changeset",
    "deploy:prod": "npm run build && sam deploy --config-env prod --profile brothersbeatsprod --no-confirm-changeset"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1032.0",
    "@aws-sdk/client-dynamodb": "^3.1032.0",
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/client-ses": "^3.1032.0",
    "@aws-sdk/client-sesv2": "^3.1032.0",
    "@aws-sdk/lib-dynamodb": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.0.1",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0",
    "stripe": "^17.4.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
